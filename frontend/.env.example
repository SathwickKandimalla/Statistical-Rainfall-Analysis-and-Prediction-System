# Frontend Environment Variables

# MapTiler API key for the interactive map
# Get your free key at https://cloud.maptiler.com/
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# Backend API base URL
# Leave unset for local development (Vite proxy handles /api → localhost:8000)
# Set to the full Render URL for production (Vercel deployment):
VITE_API_BASE_URL=https://statistical-rainfall-analysis-and.onrender.com/api
